  </head>
  <body class="min-h-screen flex flex-col">
    <main class="flex-1 w-full px-4 py-4 sm:px-6 sm:py-8 lg:px-8 lg:py-10">
      <slot />
    </main>
    <footer class="app-footer w-full px-4 pb-6 sm:px-6 lg:px-8 lg:pb-8">
      <div class="page-frame max-w-5xl px-5 py-5 sm:px-6 sm:py-6">
        <div class="flex flex-col gap-5 text-center sm:text-left sm:flex-row sm:items-end sm:justify-between">
          <div class="flex flex-col gap-2">
            <span class="eyebrow">Private by design</span>
            <p class="max-w-md text-sm sm:text-base hero-copy">Your weight history stays in your browser, so weight tracking stays private, fast, and easy to return to every day.</p>
          </div>
          <div class="flex flex-col gap-4 sm:items-end">
            <div class="flex flex-wrap justify-center gap-4 text-sm font-semibold sm:justify-end">
              <a href="/terms" class="page-link">Terms & Conditions</a>
              <a href="/privacy" class="page-link">Privacy Policy</a>
              <a href="/contact" class="page-link">Contact</a>
            </div>
            <div class="text-sm muted-copy">
              <span>© {new Date().getFullYear()} Simple Weight Loss Tracker</span>
              <div class="mt-1">
                <a
                  href="https://www.melodyapps.co.uk"
                  class="page-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Made with ❤️ by Melody Apps
                </a>
              </div>
              <!-- <div class="mt-1 text-[10px]">
                Photo by <a href="https://unsplash.com/@thekatiemchase?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText" class="page-link" target="_blank" rel="noopener noreferrer">Katherine Chase</a> on <a href="https://unsplash.com/photos/black-berries-lot-0DtoVEDaJbs?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText" class="page-link" target="_blank" rel="noopener noreferrer">Unsplash</a>
              </div> -->
            </div>
          </div>
        </div>
      </div>
    </footer>
    <!-- <CookieAlert /> -->
    <script>
      (function(projectName) {
        if (!projectName || typeof projectName !== 'string') {
          console.error('Anon Hit Counter: Project name is required');
          return;
        }
        
        const API_URL = 'https://anon-hit-counter.vercel.app/log';
        
        function getCurrentDate() {
          return new Date().toISOString().split('T')[0];
        }
        
        function sendHit() {
          fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              project: projectName,
              page: window.location.pathname,
            }),
            keepalive: true
          }).catch(function(error) {
            console.debug('Analytics request failed:', error);
          });
        }
        
        // Always use DOMContentLoaded to ensure single execution
        document.addEventListener('DOMContentLoaded', sendHit);
      })('simple-weight-loss-tracker');
    </script>
  </body>
</html>
