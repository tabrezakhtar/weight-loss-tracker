---
import WeightInput from "./WeightInput.astro";
import WeightList from "./WeightList.astro";
import Graph from "./Graph.astro";
import Units from "./Units.astro";
import Share from "./Share.astro";
import Info from "./Info.astro";
import Feedback from "./Feedback.astro";
---

<div class="flex flex-col items-center justify-center bg-transparent pt-4 pb-2">
  <div class="w-full max-w-xl mx-auto p-4 sm:p-6 bg-white rounded-2xl flex flex-col gap-4 sm:gap-6">
    <header class="flex flex-row items-center gap-2 sm:gap-4 justify-center w-full">
      <img src="/logo.png" alt="Logo" class="w-16 h-16 sm:w-20 sm:h-20 md:w-24 md:h-24 flex-shrink-0" />
      <div class="flex flex-col items-start flex-1 min-w-0">
        <h1 class="text-base sm:text-xl md:text-2xl font-bold text-slate-800 flex items-center gap-2 leading-tight">
          Simple Weight Loss Tracker
        </h1>
        <span class="text-xs sm:text-sm md:text-base text-slate-500 text-left block mt-0.5">Track your progress and stay motivated!</span>
      </div>
    </header>
    <div class="flex-shrink-0">
      <Units />
    </div>
    <div class="flex-shrink-0">
      <Graph />
    </div>
    <!-- <div class="flex-shrink-0">
      <Info />
    </div> -->
    <div>
      <WeightInput />
    </div>
    <div>
      <Share />
    </div>
    <div>
      <Feedback />
    </div>
    <div>
      <WeightList />
    </div>
  </div>
</div>