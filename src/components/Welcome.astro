---
import WeightInput from "./WeightInput.astro";
import WeightList from "./WeightList.astro";
import Graph from "./Graph.astro";
import Units from "./Units.astro";
import Share from "./Share.astro";
import Info from "./Info.astro";
import Feedback from "./Feedback.astro";
---

<div class="w-full">
  <div class="page-frame">
    <header class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr] lg:items-stretch">
      <div class="flex h-full flex-col gap-5">
        <span class="eyebrow">Weight tracking without the noise</span>
        <div class="flex items-start gap-4 sm:gap-5">
          <img src="/logo.png" alt="Logo" class="w-16 h-16 sm:w-20 sm:h-20 md:w-24 md:h-24 flex-shrink-0 rounded-[1.4rem] border border-white/70 bg-white/80 p-2 shadow-lg" />
          <div class="min-w-0">
            <h1 class="display-title text-4xl leading-none text-slate-900 sm:text-5xl lg:text-6xl">Simple Weight Loss Tracker</h1>
          </div>
        </div>
        <p class="hero-copy max-w-2xl text-sm leading-6 sm:text-base sm:leading-7">A private, browser-based tracker for people who want to see their progress, stay motivated, and keep their weight journey organised.</p>
        <div class="hidden flex-wrap gap-2.5 lg:flex">
          <span class="hero-badge">Stored locally</span>
          <span class="hero-badge">No signup</span>
          <span class="hero-badge">Fast daily updates</span>
        </div>
      </div>
      <aside class="metric-card hidden h-full flex-col p-6 sm:p-7 lg:flex">
        <!-- <div class="metric-label">Overview</div> -->
        <div class="metric-value mt-3">Track your progress</div>
        <p class="mt-4 max-w-sm text-sm leading-6 text-slate-200/82">Record your weight, see how far you’ve come, and stay focused on your goals.</p>
      </aside>
    </header>

    <div class="mt-7">
      <Graph />
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[0.85fr_1.15fr]">
      <Units />
      <WeightInput />
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
      <Share />
      <Feedback />
    </div>

    <div class="mt-6">
      <WeightList />
    </div>
  </div>
</div>