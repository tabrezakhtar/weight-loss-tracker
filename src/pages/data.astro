---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Data | Simple Weight Loss Tracker">
  <div class="page-frame max-w-5xl">
    <div class="flex flex-col gap-6">
      <header class="flex flex-col gap-2">
        <span class="eyebrow">Raw export view</span>
        <h1 class="display-title text-4xl text-slate-900 sm:text-5xl">Stored Data</h1>
        <p class="hero-copy max-w-3xl text-sm leading-6 sm:text-base sm:leading-7">This is all your weight data that is stored in your browser.</p>
      </header>
      <div class="section-card overflow-hidden p-0">
        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
          <span class="metric-label text-slate-500">Local JSON</span>
          <div class="flex items-center gap-3">
            <button id="copyDataBtn" type="button" class="ghost-button micro-button text-sm">Copy JSON</button>
            <a href="/" class="page-link text-sm font-semibold">Back</a>
          </div>
        </div>
        <div class="border-b border-slate-100 px-5 py-3">
          <p id="copyDataMessage" class="hidden text-sm text-emerald-700">JSON copied to clipboard.</p>
        </div>
        <pre id="data" class="data-mono overflow-x-auto px-5 py-5 text-sm leading-7 text-slate-700"></pre>
      </div>
    </div>
  </div>

  <script>
    const copyDataBtn = document.getElementById("copyDataBtn");
    const copyDataMessage = document.getElementById("copyDataMessage");
    const weightUnit = localStorage.getItem("weightUnit") || "kg";
    const weightEntries = JSON.parse(localStorage.getItem("weightEntries") || "[]");

    const data = {
      weightUnit: weightUnit,
      weightEntries: weightEntries
    };

    const dataText = JSON.stringify(data, null, 2);
    const dataElement = document.getElementById("data");

    dataElement.textContent = dataText;

    if (copyDataBtn && copyDataMessage) {
      copyDataBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(dataText);
          copyDataMessage.textContent = "JSON copied to clipboard.";
          copyDataMessage.classList.remove("hidden");
        } catch (error) {
          copyDataMessage.textContent = "Copy failed. You can still select and copy the JSON manually.";
          copyDataMessage.classList.remove("hidden");
        }
      });
    }
  </script>
</Layout>
