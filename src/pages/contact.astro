---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | Simple Weight Loss Tracker">
  <div class="page-frame max-w-4xl">
    <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
      <header class="flex flex-col gap-4">
        <span class="eyebrow">Contact</span>
        <h1 class="display-title text-4xl text-slate-900 sm:text-5xl">Any questions, comments, or suggestions?</h1>
      </header>
      <div class="section-card p-4 sm:p-6">
        <header class="mb-6 flex flex-col gap-1">
          <span class="eyebrow">Message form</span>
          <h2 class="display-title text-3xl text-slate-900">Contact Us</h2>
        </header>
        <form name="contact" method="POST" data-netlify="true" class="w-full">
          <div class="flex flex-col gap-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:gap-4">
              <div class="flex w-full flex-col sm:w-1/2">
                <label class="field-label mb-1.5" for="yourname">Name</label>
                <input type="text" name="yourname" id="yourname" required class="field-input" />
              </div>
              <div class="flex w-full flex-col sm:w-1/2">
                <label class="field-label mb-1.5" for="email">Email</label>
                <input type="email" name="email" id="email" required class="field-input" />
              </div>
            </div>
            <div>
              <label class="field-label mb-1.5 block" for="message">Message</label>
              <textarea name="message" id="message" rows="8" required class="field-input min-h-44 resize-y"></textarea>
            </div>
            <div class="flex items-center justify-between gap-4">
              <a href="/" class="page-link text-sm font-semibold">← Back</a>
              <button class="primary-button text-sm" type="submit">Send</button>
            </div>
          </div>
        </form>
      </header>
      </div>
    </div>
  </div>
</Layout>


